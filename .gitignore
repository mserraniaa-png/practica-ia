# LaTeX
*.aux
*.log
*.out
*.toc
*.synctex.gz

# Resultados con la muestra sintética: se regeneran, no dicen nada del modelo
resultados/sintetica/

# Carpeta armada para el Space (se regenera con scripts/preparar_space.py)
dist/

# Exportaciones de diseño (Stitch) y otros zips
*.zip
